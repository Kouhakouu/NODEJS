NODE_ENV=development

# PostgreSQL (Neon) - lấy connection string ở Neon Dashboard > Connection Details
# dạng: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
JWT_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CMATH Education <phongbui17012008@gmail.com>"

# Lưu bản sao mail đã gửi vào thư mục Sent qua IMAP (Gmail tự lưu nên không cần bật).
# Các biến IMAP_* còn lại không bắt buộc: mặc định host/user/pass lấy theo SMTP_*, cổng 993,
# thư mục Sent tự dò theo cờ \Sent của máy chủ.
IMAP_SAVE_SENT=false
IMAP_HOST=
IMAP_PORT=
IMAP_SECURE=
IMAP_USER=
IMAP_PASS=
IMAP_SENT_FOLDER=

